# App
# Production
NEXT_PUBLIC_APP_URL=https://studio.example.com
# Optional. Leave blank for production at the domain root. Set a path such as
# /website-audit only for a dev/staging deployment that needs a path prefix.
NEXT_PUBLIC_BASE_PATH=
ADMIN_TOKEN=change-me
CRON_SECRET=change-me-too
REPORT_BRAND_NAME=MsSaraJo

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_REPORT_BUCKET=audit-reports

# Google PageSpeed
PAGESPEED_API_KEY=YOUR_GOOGLE_API_KEY

# AI analysis: OpenAI primary, Gemini optional fallback
AI_PRIMARY_PROVIDER=openai
OPENAI_API_KEY=YOUR_OPENAI_KEY
OPENAI_QUICK_WIN_MODEL=gpt-5.6-luna
OPENAI_FULL_SITE_MODEL=gpt-5.6-terra
OPENAI_COMPETITOR_MODEL=gpt-5.6-terra

# Optional fallback provider
GEMINI_API_KEY=YOUR_GEMINI_KEY
GEMINI_MODEL=gemini-2.5-pro

# Optional admin-only email notifications through any authenticated SMTP mailbox.
ADMIN_NOTIFICATION_EMAIL=you@example.com
SMTP_HOST=smtp.fatcow.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASSWORD=YOUR_MAILBOX_PASSWORD

# Etsy Open API v3
ETSY_KEYSTRING=YOUR_KEYSTRING
ETSY_SHARED_SECRET=YOUR_SHARED_SECRET
ETSY_WEBHOOK_SECRET=whsec_xxx
# Optional legacy/bootstrap fallback. Leave blank when using Settings -> Connect Etsy.
ETSY_REFRESH_TOKEN=

# Three separate made-to-order Etsy digital listings
ETSY_QUICK_WIN_LISTING_IDS=111111111
ETSY_FULL_SITE_LISTING_IDS=222222222
ETSY_COMPETITOR_LISTING_IDS=333333333

# Optional local Chrome override
CHROMIUM_EXECUTABLE_PATH=
