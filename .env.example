# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_TOKEN=change-me
CRON_SECRET=change-me-too
REPORT_BRAND_NAME=SiteSignal Audit
REPORT_FROM_EMAIL=SiteSignal Audit <audits@example.com>

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_REPORT_BUCKET=audit-reports

# Google PageSpeed
PAGESPEED_API_KEY=YOUR_GOOGLE_API_KEY

# Gemini
GEMINI_API_KEY=YOUR_GEMINI_KEY
GEMINI_MODEL=gemini-2.5-pro

# Resend
RESEND_API_KEY=re_xxx

# Etsy Open API v3
ETSY_KEYSTRING=YOUR_KEYSTRING
ETSY_SHARED_SECRET=YOUR_SHARED_SECRET
ETSY_WEBHOOK_SECRET=whsec_xxx
ETSY_REFRESH_TOKEN=YOUR_INITIAL_REFRESH_TOKEN
ETSY_TIER1_LISTING_IDS=111111111
ETSY_TIER2_LISTING_IDS=222222222
ETSY_TIER3_LISTING_IDS=333333333

# Optional local Chrome override
CHROMIUM_EXECUTABLE_PATH=
